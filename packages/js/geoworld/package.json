{
  "name": "geoworld",
  "version": "0.1.0",
  "description": "Thin client for the World GeoJSON administrative boundaries: read the versioned index, download on demand, cache and verify.",
  "license": "MIT",
  "author": "Andres Marquez",
  "homepage": "https://andresgmg.github.io/World-GeoJSON/libraries/javascript/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresgmg/World-GeoJSON.git",
    "directory": "packages/js/geoworld"
  },
  "bugs": "https://github.com/andresgmg/World-GeoJSON/issues",
  "keywords": [
    "geojson",
    "administrative-boundaries",
    "gis",
    "world",
    "countries",
    "maplibre",
    "leaflet"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node.d.ts",
        "default": "./dist/esm/node.js"
      },
      "require": {
        "types": "./dist/cjs/node.d.ts",
        "default": "./dist/cjs/node.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('build-test',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "cd build-test && node --test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "~5.9.3"
  }
}
