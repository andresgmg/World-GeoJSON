{
  "name": "geoworld-leaflet",
  "version": "0.2.0",
  "description": "Leaflet helpers for geoworld: add a World GeoJSON administrative level as a GeoJSON layer, fit the map to its bbox and find sub-layers by stable id.",
  "license": "MIT",
  "author": "Andres Marquez",
  "homepage": "https://andresgmg.github.io/World-GeoJSON/libraries/leaflet/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andresgmg/World-GeoJSON.git",
    "directory": "packages/js/geoworld-leaflet"
  },
  "bugs": "https://github.com/andresgmg/World-GeoJSON/issues",
  "keywords": [
    "geojson",
    "administrative-boundaries",
    "leaflet",
    "leaflet-plugin",
    "geoworld"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('build-test',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "cd build-test && node --test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "geoworld": "^0.2.0",
    "leaflet": ">=1.9"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "geoworld": "*",
    "typescript": "~5.9.3"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    }
  }
}
