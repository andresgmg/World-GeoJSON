    family-names: Márquez
    alias: andresgmg
repository-code: https://github.com/andresgmg/World-GeoJSON
url: https://andresgmg.github.io/World-GeoJSON/
license: MIT
version: 1.0.0
keywords:
  - geojson
  - administrative boundaries
  - gis
  - open data
